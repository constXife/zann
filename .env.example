ZANN_ADDR=0.0.0.0:8080
ZANN_CONFIG_PATH=/config/dev.yaml

# Required by compose.yaml. Generate each value once and keep it stable:
#   openssl rand -base64 32
# Rotating a pepper invalidates tokens (token pepper) and internal-auth
# password verification (password pepper).
ZANN_PASSWORD_PEPPER=
ZANN_TOKEN_PEPPER=
