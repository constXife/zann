case "$(uname -s)" in
  Linux)
    use flake
    ;;
  Darwin)
    export SDKROOT="$(/usr/bin/xcrun --show-sdk-path)"
    export CC="$(/usr/bin/xcrun --find clang)"
    export CXX="$(/usr/bin/xcrun --find clang++)"
    case "${RUSTFLAGS:-}" in
      *link-arg=-isysroot*) ;;
      *) export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C link-arg=-isysroot -C link-arg=$SDKROOT" ;;
    esac
    case "$(uname -m)" in
      arm64) export CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER="$CC" ;;
      x86_64) export CARGO_TARGET_X86_64_APPLE_DARWIN_LINKER="$CC" ;;
    esac
    ;;
esac

# Стабильный путь к тулчейну для IDE. В RustRover в "Rust → Toolchain
# location" указывается .direnv/toolchain — и настройка переживает
# обновления flake.lock, потому что симлинк обновляет direnv.
mkdir -p .direnv
ln -sfn "$(dirname "$(command -v rustc)")" .direnv/toolchain

ZANN_DESKTOP_DIR="$PWD/apps/desktop"
PATH_add "$ZANN_DESKTOP_DIR/node_modules/.bin"

if [ -f "$ZANN_DESKTOP_DIR/package.json" ] && [ ! -d "$ZANN_DESKTOP_DIR/node_modules" ] && [ -z "$ZANN_SKIP_BUN_INSTALL" ]; then
  echo "apps/desktop: installing bun deps (set ZANN_SKIP_BUN_INSTALL=1 to skip)"
  (cd "$ZANN_DESKTOP_DIR" && bun install)
fi
