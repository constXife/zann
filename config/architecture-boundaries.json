  "exceptions": {
    "MIG-001": {
      "owner": "@constXife",
      "tracking": "ADR-0001 phase 4",
      "grandfathered": true,
      "review_on": "2026-11-16",
      "removal_condition": "Tauri uses zann-client remote/auth/sync and its fork is deleted"
    },
    "MIG-002": {
      "owner": "@constXife",
      "tracking": "ADR-0001 phase 3",
      "grandfathered": true,
      "review_on": "2026-11-16",
      "removal_condition": "CLI uses remote-only zann-client and zann-client local storage is optional"
    },
    "MIG-003": {
      "owner": "@constXife",
      "tracking": "ADR-0001 phase 5",
      "grandfathered": true,
      "review_on": "2026-11-16",
      "removal_condition": "Tauri and COSMIC use AppClient and zann-ffi is an edge adapter"
    },
    "MIG-004": {
      "owner": "@constXife",
      "tracking": "ADR-0001 phase 2",
      "grandfathered": true,
      "review_on": "2026-11-16",
      "removal_condition": "All client KDF and payload crypto calls route through zann-crypto"
    },
    "MIG-005": {
      "owner": "@constXife",
      "tracking": "ADR-0001 phase 2",
      "grandfathered": true,
      "review_on": "2026-11-16",
      "removal_condition": "Every client uses config v2, ClientPaths and CredentialStore"
    },
    "MIG-006": {
      "owner": "@constXife",
      "tracking": "ADR-0001 phase 6",
      "grandfathered": true,
      "review_on": "2026-11-16",
      "removal_condition": "All clients consume zann-flows and canonical zann-ui-core presentation policy"
    },
    "MIG-007": {
      "owner": "@constXife",
      "tracking": "ADR-0001 phase 5",
      "grandfathered": true,
      "review_on": "2026-11-16",
      "removal_condition": "SQLx row mapping and features move from zann-core to zann-db"
    }
  },
